API_KEYS=grup-a:ganti-key-a,grup-b:ganti-key-b,grup-c:ganti-key-c,grup-d:ganti-key-d,trainer:ganti-key-trainer
# Kosongkan agar waktu berjalan nyata. Isi untuk membekukan waktu demo (WITA).
SIM_NOW=
# csv (default, tanpa database) atau mysql
DATA_BACKEND=csv
# Wajib bila DATA_BACKEND=mysql. Di Railway: ${{MySQL.MYSQL_URL}}
DATABASE_URL=
